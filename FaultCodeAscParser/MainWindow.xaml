<Window x:Class="FaultCodeAscParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASC 故障码解析工具_康普顿充电器项目专用" Height="850" Width="1300" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1769AA" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0D5792" />
        <SolidColorBrush x:Key="TextBrush" Color="#1A2A3A" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5B6B7B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D7E1EC" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="TextBoxBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="#F8FAFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.FontWeight="SemiBold"
                                                      TextElement.Foreground="{StaticResource TextBrush}" />
                                </Border>
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF5" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFD" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EAF1F8" />
                        <Setter Property="Foreground" Value="#38516A" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderBrush" Value="#D7E1EC" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D8ECFA" />
                                <Setter Property="Foreground" Value="#123B5B" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按字段类别采用浅色底纹，方便在同一行内快速区分不同列。 -->
        <Style x:Key="PositionHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9EEF4" />
            <Setter Property="Foreground" Value="#40556C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#D7E1EC" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style x:Key="TimeHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource PositionHeaderStyle}">
            <Setter Property="Background" Value="#DDECF9" />
            <Setter Property="Foreground" Value="#245A87" />
        </Style>
        <Style x:Key="SignalHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource PositionHeaderStyle}">
            <Setter Property="Background" Value="#DDF2EE" />
            <Setter Property="Foreground" Value="#21665B" />
        </Style>
        <Style x:Key="DataHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource PositionHeaderStyle}">
            <Setter Property="Background" Value="#FFF0D6" />
            <Setter Property="Foreground" Value="#896020" />
        </Style>
        <Style x:Key="StatusHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource PositionHeaderStyle}">
            <Setter Property="Background" Value="#EEE8FA" />
            <Setter Property="Foreground" Value="#624D90" />
        </Style>

        <Style x:Key="PositionCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#F6F8FA" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Background" Value="#087DCE" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TimeCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#F1F8FD" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Background" Value="#087DCE" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SignalCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#EFF9F7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Background" Value="#087DCE" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DataCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#FFF9ED" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Background" Value="#087DCE" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="#F5F1FC" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Background" Value="#087DCE" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Background="#173F67" CornerRadius="8" Padding="22,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ASC 故障码解析工具，仅用于康普顿换电柜项目" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Margin="0,6,0,0" Foreground="#D5E7F6" TextWrapping="Wrap"
                               Text="导入 Vector ASC 日志，选中 CAN 报文后自动解析 0x1F1C10xx~0x1F2010xx 定时上传及调试回复故障报码。" />
                </StackPanel>
                <Border Grid.Column="1" Background="#2B608C" CornerRadius="14" Padding="12,5" VerticalAlignment="Top">
                    <TextBlock Text="0x10 ~ 0x14" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="210" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="OpenAscButton" Content="打开 ASC 文件" Click="OpenAscFile_Click" Margin="0,0,12,0" />
                <TextBox Grid.Column="1" x:Name="FilePathTextBox" IsReadOnly="True" />
                <TextBlock Grid.Column="2" Text="帧 ID 筛选" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="18,0,8,0" />
                <TextBox Grid.Column="3" x:Name="FrameIdFilterTextBox"
                         ToolTip="输入 CAN ID 的任意十六进制片段，例如 1810、1080 或 1CA0。留空显示全部报文。"
                         TextChanged="FrameIdFilterTextBox_TextChanged" />
            </Grid>
        </Border>

        <Border x:Name="ReadProgressPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFF9E9" BorderBrush="#E8C767" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ReadProgressTextBlock" Grid.Column="0" Text="正在读取 ASC 文件：0%" FontWeight="SemiBold"
                           Foreground="#795B00" VerticalAlignment="Center" Margin="0,0,16,0" />
                <ProgressBar x:Name="ReadProgressBar" Grid.Column="1" Minimum="0" Maximum="100" Height="14"
                             Foreground="#D69A00" Background="#F4E4AF" BorderThickness="0" />
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,14,0,0" Padding="6,3">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="请选择 ASC 文件。" Foreground="{StaticResource MutedTextBrush}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <GroupBox Header="ASC 全部 CAN 报文  ·  选中一条报文进行故障解析" Grid.Row="0">
                    <DataGrid x:Name="AllFramesDataGrid" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionChanged="AllFramesDataGrid_SelectionChanged" CellEditEnding="AllFramesDataGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="行号" Binding="{Binding SourceLine}" Width="65" IsReadOnly="True" HeaderStyle="{StaticResource PositionHeaderStyle}" CellStyle="{StaticResource PositionCellStyle}" />
                            <DataGridTextColumn Header="实际时间" Binding="{Binding TimestampText}" Width="185" HeaderStyle="{StaticResource TimeHeaderStyle}" CellStyle="{StaticResource TimeCellStyle}" />
                            <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="60" HeaderStyle="{StaticResource PositionHeaderStyle}" CellStyle="{StaticResource PositionCellStyle}" />
                            <DataGridTextColumn Header="CAN ID" Binding="{Binding CanIdText}" Width="120" HeaderStyle="{StaticResource SignalHeaderStyle}" CellStyle="{StaticResource SignalCellStyle}" />
                            <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="65" HeaderStyle="{StaticResource PositionHeaderStyle}" CellStyle="{StaticResource PositionCellStyle}" />
                            <DataGridTextColumn Header="DLC" Binding="{Binding DataLength}" Width="60" IsReadOnly="True" HeaderStyle="{StaticResource PositionHeaderStyle}" CellStyle="{StaticResource PositionCellStyle}" />
                            <DataGridTextColumn Header="data0" Binding="{Binding Data0Text}" Width="70" HeaderStyle="{StaticResource DataHeaderStyle}" CellStyle="{StaticResource DataCellStyle}" />
                            <DataGridTextColumn Header="报文数据（data0~data7）" Binding="{Binding DataText}" Width="*" HeaderStyle="{StaticResource DataHeaderStyle}" CellStyle="{StaticResource DataCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GroupBox Header="选中报文的故障列表" Grid.Row="2">
                    <DataGrid x:Name="FaultDataGrid" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="页面" Binding="{Binding Selector, StringFormat=0x{0:X2}}" Width="75" HeaderStyle="{StaticResource DataHeaderStyle}" CellStyle="{StaticResource DataCellStyle}" />
                            <DataGridTextColumn Header="首故障码" Binding="{Binding FirstFaultCodeText}" Width="105" HeaderStyle="{StaticResource SignalHeaderStyle}" CellStyle="{StaticResource SignalCellStyle}" />
                            <DataGridTextColumn Header="故障域" Binding="{Binding Domain}" Width="140" HeaderStyle="{StaticResource TimeHeaderStyle}" CellStyle="{StaticResource TimeCellStyle}" />
                            <DataGridTextColumn Header="PDF 编号" Binding="{Binding PdfNumber}" Width="95" HeaderStyle="{StaticResource PositionHeaderStyle}" CellStyle="{StaticResource PositionCellStyle}" />
                            <DataGridTextColumn Header="故障名称" Binding="{Binding FaultName}" Width="*" HeaderStyle="{StaticResource SignalHeaderStyle}" CellStyle="{StaticResource SignalCellStyle}" />
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100" HeaderStyle="{StaticResource StatusHeaderStyle}" CellStyle="{StaticResource StatusCellStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <GroupBox Grid.Column="2" Header="实时/锁存故障位表  ·  置 1 的 bit 行显示为红色">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FaultVisualDomainTextBlock" Text="请选择 data0 = 0x10 ~ 0x14 的故障报码报文。"
                               Foreground="#5B6B7B" TextWrapping="Wrap" Margin="3,0,3,8" />
                    <TextBlock x:Name="RealtimeFaultVisualTextBlock" Grid.Row="1" Text="实时故障位图"
                               Foreground="#245A87" FontWeight="SemiBold" Margin="3,0,3,5" />
                    <DataGrid x:Name="FaultVisualDataGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              RowHeight="16" FontSize="11" HeadersVisibility="Column" VerticalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#38516A" />
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSet}" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="#D54444" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="bit" Binding="{Binding Bit, StringFormat=bit{0}}" Width="65" />
                            <DataGridTextColumn Header="实时故障" Binding="{Binding FaultName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="LatchedFaultVisualTextBlock" Grid.Row="3" Text="锁存故障位图"
                               Foreground="#7A4E22" FontWeight="SemiBold" Margin="3,8,3,5" />
                    <DataGrid x:Name="LatchedFaultVisualDataGrid" Grid.Row="4" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              RowHeight="16" FontSize="11" HeadersVisibility="Column" VerticalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="#38516A" />
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSet}" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="#D54444" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="bit" Binding="{Binding Bit, StringFormat=bit{0}}" Width="65" />
                            <DataGridTextColumn Header="锁存故障" Binding="{Binding FaultName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>