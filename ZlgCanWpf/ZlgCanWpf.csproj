<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 使用完整 Windows 平台 TFM，与 NuGet assets 目标键一致；7.0 是平台版本，不代表 Windows 7 运行时兼容性。 -->
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>ZlgCanWpf</AssemblyName>
    <RootNamespace>ZlgCanWpf</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="CanModels.cs" />
    <Compile Include="FaultModels.cs" />
    <Compile Include="FaultCatalog.cs" />
    <Compile Include="FaultReportDecoder.cs" />
    <Compile Include="AscParser.cs" />
    <Compile Include="ZlgCanNative.cs" />
    <Compile Include="ControlCanNative.cs" />
    <Compile Include="ZlgCanService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="zlgcan_c#_20241120\ZLGCAN\bin\x64\Release\zlgcan.dll">
      <Link>zlgcan.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="C#_Example(VS2019)\WindowsApplication1\bin\x64\Release\ControlCAN.dll">
      <Link>ControlCAN.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="zlgcan_c#_20241120\ZLGCAN\bin\x64\Release\kerneldlls\**\*">
      <Link>kerneldlls\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
